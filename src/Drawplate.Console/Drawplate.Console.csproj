<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>drawplate</AssemblyName>
    <OutputType>Exe</OutputType>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <StartupObject>Drawplate.Console.Program</StartupObject>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\\Drawplate.Models\\Drawplate.Models.csproj" />
    <ProjectReference Include="..\\Drawplate.Services\\Drawplate.Services.csproj" />
  </ItemGroup>

</Project>
