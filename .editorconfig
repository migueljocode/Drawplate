root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

*.cs
csharp_style_var_elsewhere = true
csharp_style_pattern_matching_over_is_with_null_check = true
csharp_style_throw_expression = true
csharp_style_conditional_delegate_call = true
csharp_style_expression_bodied_methods = true
csharp_style_expression_bodied_constructors = true
csharp_style_expression_bodied_operators = true
csharp_style_expression_bodied_properties = true
csharp_style_expression_bodied_indexers = true
csharp_style_expression_bodied_accessors = true
csharp_style_object_initializer = true
csharp_style_collection_expression = true
csharp_style_switch_expression = true
csharp_prefer_simple_using_statement = true
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true
dotnet_style_operator_placement_when_wrapping = chop_always
dotnet_style_qualification = false
dotnet_style_require_accessibility_modifiers = always_for_non_interface_members
dotnet_style_readonly_field = true
dotnet_style_coalesce_expression = true
dotnet_style_object_initializer = true
dotnet_style_collection_initializer = true
dotnet_style_definite_variable_declaration_for_reference_types = true
dotnet_diagnostic.CA1707.severity = none

# xUnit requires public test classes (xUnit1000); CA1515 does not apply to test classes.
[tests/Drawplate.Tests/**/*.cs]
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2007.severity = none
